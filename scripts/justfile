repo := "distractionzero/textonomy"
model := "../data/work/model/sms_model.bin"

# Publish the exported model as the next semver release (tag + asset sms-model.bin)
release bump:
    #!/usr/bin/env bash
    set -euo pipefail
    [[ -n "${GH_TOKEN:-}${GITHUB_TOKEN:-}" ]] || { echo "set GH_TOKEN (or GITHUB_TOKEN) first"; exit 1; }
    [[ -f "{{model}}" ]] || { echo "missing {{model}}; run export.py first"; exit 1; }
    visibility=$(gh repo view "{{repo}}" --json visibility -q .visibility)
    [[ "$visibility" != "PUBLIC" ]] || { echo "refusing: {{repo}} is public and the model vocabulary comes from your SMS"; exit 1; }

    latest=$(gh release list --repo "{{repo}}" --limit 1000 --json tagName -q '.[].tagName' \
      | { grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' || true; } | sort -V | tail -n1)
    IFS=. read -r major minor patch <<< "${latest:-v0.0.0}"
    major=${major#v}
    case "{{bump}}" in
      major) version="v$((major + 1)).0.0" ;;
      minor) version="v${major}.$((minor + 1)).0" ;;
      patch) version="v${major}.${minor}.$((patch + 1))" ;;
      *) echo "usage: just release {patch|minor|major}"; exit 1 ;;
    esac
    echo "${latest:-none} -> $version"

    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    cp "{{model}}" "$tmp/sms-model.bin"
    sha=$(sha256sum "$tmp/sms-model.bin" | cut -d' ' -f1)
    gh release create "$version" "$tmp/sms-model.bin" --repo "{{repo}}" \
      --title "$version" --notes "sha256: $sha"
